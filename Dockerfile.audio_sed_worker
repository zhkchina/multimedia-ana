FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace

COPY requirements/audio_sed_worker.txt /tmp/requirements-audio-sed-worker.txt
COPY requirements/audio_sed_worker_constraints.txt /tmp/requirements-audio-sed-worker-constraints.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libsndfile1 git curl build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && python -c "import torch, torchaudio, torchvision; print('base torch stack:', torch.__version__, torchaudio.__version__, torchvision.__version__)" \
    && pip install --no-cache-dir \
        -c /tmp/requirements-audio-sed-worker-constraints.txt \
        -r /tmp/requirements-audio-sed-worker.txt \
    && python -c "import torch, torchaudio, torchvision; assert torch.__version__ == '2.7.1+cu128', torch.__version__; assert torchaudio.__version__ == '2.7.1+cu128', torchaudio.__version__; assert torchvision.__version__ == '0.22.1+cu128', torchvision.__version__; print('kept torch stack:', torch.__version__, torchaudio.__version__, torchvision.__version__)"

COPY app /workspace/app

CMD ["python3", "-m", "app.audio_sed_worker.pipeline", "--help"]
